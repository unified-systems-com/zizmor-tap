                  "header_tooltip": "zizmor's severity for this finding: High, Medium, Low, Informational, or Unknown.",
                  "formatter_params": {
                    "tones": {
                      "High": "bad",
                      "Medium": "warn",
                      "Low": "muted",
                      "Informational": "muted"
