        {
          "entity": {
            "entity_id": "01a08ccf-409e-74ea-aaa5-67913c691a5b",
            "entity_type": "panel",
            "name": "Findings",
            "dimensions": {
              "tap.graph": "web"
            }
          },
          "node": {
            "slug": "zizmor-findings-table",
            "name": "Findings",
            "view": "tap_web/panels/table_panel.html",
            "editor_view": "",
            "config": {
              "hide_header": false,
              "height": 520,
              "quick_filter": true,
              "default_page_size": 100,
              "columns": [
                {
                  "field": "data.audit_id",
                  "title": "Audit",
                  "width": 200,
                  "headerSort": true,
                  "header_tooltip": "zizmor's own name for the rule that fired. Click through for the finding in full — where it is, what the job it sits in is permitted to do, and how long it has been there.",
                  "formatter": "link",
                  "formatter_params": {
                    "href_template": "/zizmor/finding?finding_id={data.entity_id}"
                  }
                },
                {
                  "field": "data.severity",
                  "title": "Severity",
                  "width": 110,
                  "align": "center",
                  "headerSort": true,
                  "formatter": "toneBadge",
                  "header_tooltip": "zizmor's severity for this finding: High, Medium, Low, Informational, or Unknown.",
                  "formatter_params": {
                    "tones": {
                      "High": "bad",
                      "Medium": "warn",
                      "Low": "muted",
                      "Informational": "muted"
                    }
                  }
                },
                {
                  "field": "data.confidence",
                  "title": "Confidence",
                  "width": 110,
                  "align": "center",
                  "headerSort": true,
                  "formatter": "toneBadge",
                  "header_tooltip": "How sure zizmor is. Only Low is marked — it is the one value that changes how you read the finding. Low confidence is not a false positive, but it is a hint about reading order.",
                  "formatter_params": {
                    "tones": {
                      "Low": "warn"
                    }
                  }
                },
                {
                  "field": "data.persona",
                  "title": "Persona",
                  "width": 100,
                  "align": "center",
                  "headerSort": true,
                  "header_tooltip": "The persona this finding belongs to. An auditor run emits Regular, Pedantic and Auditor findings together, and which one this is decides whether it is worth acting on."
                },
                {
                  "field": "data.location.path",
                  "title": "Workflow",
                  "widthGrow": 2,
                  "headerSort": true,
                  "header_tooltip": "The workflow file the finding is about, as the grid knows it."
                },
                {
                  "field": "data.location.job_key",
                  "title": "Job",
                  "width": 140,
                  "headerSort": true,
                  "header_tooltip": "The job the finding sits in, when its location names one. Blank means the finding is workflow-level, not that the job is unknown."
                },
                {
                  "field": "data.location.subfeature",
                  "title": "Fragment",
                  "width": 160,
                  "header_tooltip": "The exact expression the finding is about, when zizmor narrowed to one — far more useful than the whole run: block it sits in."
                },
                {
                  "field": "data.observed_at",
                  "title": "Observed",
                  "width": 170,
                  "headerSort": true,
                  "header_tooltip": "When the most recent run saw this finding.",
                  "formatter": "datetime"
                },
                {
                  "field": "data.known_since",
                  "title": "Known since",
                  "width": 170,
                  "headerSort": true,
                  "header_tooltip": "When this finding was FIRST seen. It does not reset when a later run re-observes the same finding, so the gap between the two columns is how long the defect has been there.",
                  "formatter": "datetime"
                }
              ]
            }
          }
        },
