        {
          "entity": {
            "entity_id": "01a08db6-4016-7590-b5cc-020e576d2e74",
            "entity_type": "search",
            "name": "zizmor Findings on one workflow",
            "dimensions": {
              "tap.graph": "web"
            }
          },
          "node": {
            "name": "zizmor Findings on one workflow",
            "description": "Every zizmor finding whose FLAGS_WORKFLOW edge lands on the workflow with the given GitHub workflow_id (zizmor-tap#28). Envelope mode (RETURN f) for the table; no ORDER BY — refused on a traversal (req-grid-gryphon-order-by-envelope), the table sorts client-side. Cumulative, not current (no tombstoning yet, zizmor-tap#27). Consumers point USES_SEARCH at this node; do not copy the query.",
            "search_type": "gryphon",
            "root": "node",
            "definition": {
              "query": [
                "MATCH (f:zizmor__finding)-[:FLAGS_WORKFLOW__zizmor]->(w:github_core__github_workflow)",
                "WHERE w.data.workflow_id = $workflow_id",
                "RETURN f"
              ]
            },
            "input_schema": {
              "type": "object",
              "properties": {
                "workflow_id": {
                  "type": "integer",
                  "description": "GitHub's numeric workflow id (github_workflow.workflow_id), from the page URL ?workflow_id=… Typed integer so the page's string is coerced before it meets the integer field."
                }
              },
              "required": [
                "workflow_id"
              ],
              "additionalProperties": false
            },
            "max_limit": 1000
          }
        },
        {
          "entity": {
            "entity_id": "01a08ded-2e43-7366-8abd-50e7f1cbc6a1",
