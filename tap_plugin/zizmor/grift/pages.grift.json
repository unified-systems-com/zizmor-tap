            "config": {
              "hide_header": false,
              "height": 320,
              "default_page_size": 25,
              "columns": [
                {
                  "field": "data.started_at",
                  "title": "Started",
                  "width": 180,
                  "headerSort": true
                },
                {
                  "field": "data.outcome",
                  "title": "Outcome",
                  "width": 110,
                  "align": "center",
                  "formatter": "toneBadge",
                  "capitalize": true,
                  "header_tooltip": "ok: everything the run attempted succeeded. partial: it failed to evaluate something it tried. Workflows with no YAML are counted but do not make a run partial — that is an upstream gap, not a fault in the run."
                },
                {
                  "field": "data.scanner_version",
                  "title": "Scanner",
                  "width": 100,
                  "align": "center"
                },
                {
                  "field": "data.workflows_evaluated",
                  "title": "Scanned",
                  "width": 100,
                  "align": "right",
                  "headerSort": true,
                  "header_tooltip": "Workflows the scanner actually read."
                },
                {
                  "field": "data.workflows_no_yaml",
                  "title": "No YAML",
                  "width": 100,
                  "align": "right",
                  "headerSort": true,
                  "header_tooltip": "Collected, but no workflow body was captured, so the scanner never read them. Their findings are unknown, not zero."
                },
                {
                  "field": "data.workflows_parse_failed",
                  "title": "Unparseable",
                  "width": 110,
                  "align": "right"
                },
                {
                  "field": "data.workflows_skipped",
                  "title": "Refused",
                  "width": 100,
                  "align": "right"
                },
                {
                  "field": "data.repositories_scanned",
                  "title": "Repos",
                  "width": 90,
                  "align": "right"
                }
              ]
            }
          }
        },
        {
          "entity": {
            "entity_id": "01a08ccf-409e-74ea-aaa5-6794181a68e9",
            "entity_type": "search",
            "name": "zizmor Findings",
            "dimensions": {}
          },
          "node": {
            "name": "zizmor Findings",
            "description": "Every zizmor finding currently on the grid, newest observation first. Findings are keyed on the assertion (workflow, audit, route, persona, fragment) rather than on the run that saw them, so a re-scan re-observes the same node instead of minting a copy. IMPORTANT, until zizmor-tap#27 lands: the collector never tombstones, so a finding that has since been FIXED still appears here — this is every finding ever observed, not the current state. Scoping it to the latest run would be worse, because a workflow that run could not read (no-yaml, parse-failed) would silently lose everything previously known about it. What this list cannot say at all is which workflows were never read; that is the coverage panel's job, and a findings list without it renders silence as safety.",
            "search_type": "gryphon",
            "root": "node",
            "definition": {
              "query": [
                "MATCH (f:zizmor__finding)",
                "RETURN f",
                "ORDER BY f.data.observed_at DESC"
              ]
            },
            "input_schema": {
              "type": "object",
              "properties": {}
            },
            "max_limit": 1000
          }
        },
        {
          "entity": {
            "entity_id": "01a08ccf-409e-74ea-aaa5-67951862e82e",
            "entity_type": "search",
            "name": "zizmor Runs",
            "dimensions": {}
          },
          "node": {
            "name": "zizmor Runs",
            "description": "Recent zizmor collector executions, newest first. Each run records the scanner version and persona it ran with, the github_core collection it read, the audits it ran and the ones it could not, its per-workflow coverage, and the finding counts its PRODUCED_FINDING edges must add up to.",
            "search_type": "gryphon",
            "root": "node",
            "definition": {
              "query": [
                "MATCH (r:zizmor__run)",
                "RETURN r",
                "ORDER BY r.data.started_at DESC"
              ]
            },
            "input_schema": {
              "type": "object",
              "properties": {}
            },
            "max_limit": 200
          }
        },
