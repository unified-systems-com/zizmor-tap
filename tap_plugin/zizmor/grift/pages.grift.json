        {
          "entity": {
            "entity_id": "01a08ccf-409e-74ea-aaa5-6794181a68e9",
            "entity_type": "search",
            "name": "zizmor Findings",
            "dimensions": {}
          },
          "node": {
            "name": "zizmor Findings",
            "description": "Every zizmor finding currently on the grid, newest observation first. Findings are keyed on the assertion (workflow, audit, route, persona, fragment) rather than on the run that saw them, so a re-scan re-observes the same node instead of minting a copy. IMPORTANT, until zizmor-tap#27 lands: the collector never tombstones, so a finding that has since been FIXED still appears here — this is every finding ever observed, not the current state. Scoping it to the latest run would be worse, because a workflow that run could not read (no-yaml, parse-failed) would silently lose everything previously known about it. What this list cannot say at all is which workflows were never read; that is the coverage panel's job, and a findings list without it renders silence as safety.",
            "search_type": "gryphon",
            "root": "node",
            "definition": {
              "query": [
                "MATCH (f:zizmor__finding)",
                "RETURN f",
                "ORDER BY f.data.observed_at DESC"
              ]
            },
            "input_schema": {
              "type": "object",
              "properties": {}
            },
            "max_limit": 1000
          }
        },
        {
          "entity": {
            "entity_id": "01a08ccf-409e-74ea-aaa5-67951862e82e",
            "entity_type": "search",
            "name": "zizmor Runs",
            "dimensions": {}
          },
          "node": {
            "name": "zizmor Runs",
            "description": "Recent zizmor collector executions, newest first. Each run records the scanner version and persona it ran with, the github_core collection it read, the audits it ran and the ones it could not, its per-workflow coverage, and the finding counts its PRODUCED_FINDING edges must add up to.",
            "search_type": "gryphon",
            "root": "node",
            "definition": {
              "query": [
                "MATCH (r:zizmor__run)",
                "RETURN r",
                "ORDER BY r.data.started_at DESC"
              ]
            },
            "input_schema": {
              "type": "object",
              "properties": {}
            },
            "max_limit": 200
          }
        },
